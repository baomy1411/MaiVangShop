# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên GitHub hay gửi cho người khác.

# Chuỗi kết nối Neon (neon.com -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Tài khoản quản trị (tạo ở lần chạy đầu)
ADMIN_EMAIL=email-cua-ban@gmail.com
ADMIN_PASSWORD=dat-mat-khau-manh-o-day

# Chuỗi ngẫu nhiên dài. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Khi chạy thật trên Render
# NODE_ENV=production
# BASE_URL=https://ten-mien-cua-ban.onrender.com

# Thông báo đơn mới/tin nhắn qua Telegram (miễn phí)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
